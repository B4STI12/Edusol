---js
{
  layout: "layouts/base.njk",
  pagination: { data: "fields", size: 1, alias: "field", addAllPagesToCollections: true },
  permalink: (data) => `/${data.field.slug}.html`,
  eleventyComputed: {
    title: (data) => data.field.title,
    fullTitle: (data) => data.field.seoTitle,
    description: (data) => data.field.description,
    ctaTopic: (data) => data.field.slug,
    breadcrumb: (data) => [
      { name: "Wirkungsfelder", url: "/#wirkungsfelder" },
      { name: data.field.menuTitle, url: `/${data.field.slug}.html` },
    ],
  },
}
---
<div class="theme-{{ field.slug }}">
  <section class="field-hero">
    <div class="container field-hero__inner">
      <nav class="breadcrumb" aria-label="Brotkrümelpfad">
        <ol>
          <li><a href="/">Startseite</a></li>
          <li><a href="/#wirkungsfelder">Wirkungsfelder</a></li>
          <li><span class="accent-text" aria-current="page">{{ field.menuTitle }}</span></li>
        </ol>
      </nav>
      <div class="field-hero__grid">
        <div class="stack stack-lg">
          <h1>
            <img class="field-hero__wordmark" src="/assets/img/fachgebiete/{{ field.slug }}.svg" width="{{ (field.heroWidth * 64 / 160) | round }}" height="64" alt="{{ field.title }}" fetchpriority="high">
          </h1>
          <p class="field-hero__teaser">{{ field.lead }}</p>
          <div class="cluster">
            <a class="btn btn--primary" href="/kontakt.html?thema={{ field.slug }}">Angebot anfragen</a>
            {%- if field.slug == "krisenmanagement" %}
            <a class="btn btn--crisis" href="/akut.html">Akut-Hilfe</a>
            {%- endif %}
          </div>
        </div>
        <div class="formats">
          <h2 class="formats__label">Unsere Formate</h2>
          <ol class="formats__list">
            {%- for o in field.features %}
            <li class="formats__item">
              <span class="num" aria-hidden="true">{{ loop.index }}</span>
              <div class="stack">
                <h3>{{ o.title }}</h3>
                <p>{{ o.text }}</p>
              </div>
            </li>
            {%- endfor %}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container grid-2">
      <div class="stack stack-md">
        <h2 class="h-sub">{{ field.heading }}</h2>
        <p class="prose">{{ field.body }}</p>
      </div>
      <div class="stack stack-md">
        <h2 class="h-sub">So starten wir</h2>
        <ol class="steps">
          {%- for st in steps %}
          <li class="steps__item">
            <span class="num num--lg" aria-hidden="true">{{ loop.index }}</span>
            <div>
              <h3>{{ st.title }}</h3>
              <p>{{ st.text }}</p>
            </div>
          </li>
          {%- endfor %}
        </ol>
      </div>
    </div>
  </section>
</div>

<section class="section section--soft" aria-labelledby="weitere-title">
  <div class="container stack stack-md">
    <h2 class="h-small" id="weitere-title">Weitere Wirkungsfelder</h2>
    <ul class="other-fields">
      {%- for f in fields %}{% if f.slug != field.slug %}
      <li class="theme-{{ f.slug }}">
        <a href="/{{ f.slug }}.html"><img src="/assets/img/eulen/{{ f.slug }}.svg" width="40" height="36" alt="" loading="lazy">{{ f.menuTitle }}</a>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>
