<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- GitHub Pages erlaubt keine eigenen HTTP-Header; frame-ancestors und Reporting wirken erst als Header. #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; form-action https://formspree.io; base-uri 'none'; object-src 'none'; upgrade-insecure-requests">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  {%- set pageTitle = fullTitle or (title + " – " + site.name) %}
  {%- set canonical = page.url | absoluteUrl(site.url) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  {%- if site.noindex or noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {%- if not excludeFromSitemap %}
  <link rel="canonical" href="{{ canonical }}">
  {%- endif %}
  <meta name="theme-color" content="{{ site.themeColor }}">

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ '/assets/og/og-image.png' | absoluteUrl(site.url) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="EDUSOL – {{ site.claim }}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preload" href="/assets/fonts/poppins-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/poppins-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  {%- if preloadImage %}
  <link rel="preload" href="{{ preloadImage }}" as="image" type="image/svg+xml" fetchpriority="high">
  {%- endif %}

  {% include "partials/jsonld.njk" %}
</head>
<body>
  <a class="skip-link" href="#main">Zum Inhalt springen</a>

  {% include "partials/header.njk" %}

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/vendor/bootstrap.bundle.min.js" defer></script>
  {%- if pageScript %}
  <script src="{{ pageScript }}" defer></script>
  {%- endif %}
</body>
</html>
